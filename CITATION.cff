  - aerial imagery
  - structure from motion
  - laser scanning
  - point cloud
  - 3D reconstruction
  - UAV
  - drone
  - dataset
  - vegetation
  - tree
  - Minnesota
repository-code: "https://github.com/Matt1Up/tree-photogrammetry-dataset"
